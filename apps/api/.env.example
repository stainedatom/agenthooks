# Server Port (Default: 4000)
# PORT=

# Node Environment (development | production) (Default: development)
NODE_ENV=

# MongoDB Connection String
# The default in config.ts will be used if this is empty or missing.
MONGODB_URI=

# Database Name (Default: agenthooks)
# DB_NAME=

# Authentication Secrets
# Secrets will use dev defaults if left empty.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# Client Origin for CORS (Default: http://localhost:3000)
CLIENT_ORIGIN=

# AI Provider / Ollama Base URL (Default: https://ollama.com/api)
OLLAMA_BASE_URL=

# Ollama API Key (Required for AI features & Ollama Cloud)
OLLAMA_API_KEY=

AI_MODEL=
